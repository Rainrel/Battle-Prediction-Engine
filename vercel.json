{
  "framework": "vite",
  "installCommand": "npm --prefix Battle_Engine_Project_Draft ci",
  "buildCommand": "npm --prefix Battle_Engine_Project_Draft run build",
  "outputDirectory": "Battle_Engine_Project_Draft/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
